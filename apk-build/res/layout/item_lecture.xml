<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tile" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center" android:background="@drawable/tile"
    android:minHeight="58dp" android:padding="@dimen/pad_sm" android:clickable="true">
    <TextView android:id="@+id/lecNum" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="@dimen/text_body" android:textStyle="bold" android:textColor="@color/text_primary" />
    <TextView android:id="@+id/lecIcons" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="10sp" android:textColor="@color/text_tertiary" />
</LinearLayout>
