<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="@dimen/pad_xl">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="সব লিঙ্ক একসাথে পেস্ট করুন — অ্যাপ নিজেই প্রতিটি লেকচারে বসিয়ে দেবে"
        android:textSize="@dimen/text_small" android:textColor="@color/text_secondary" />
    <EditText android:id="@+id/inBulk" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="130dp" android:gravity="top|left" android:inputType="textMultiLine|textNoSuggestions"
        android:hint="@string/bulk_hint" android:background="@drawable/outline_box" android:padding="@dimen/pad_md"
        android:layout_marginTop="@dimen/pad_md" android:textSize="@dimen/text_small"
        android:textColor="@color/text_primary" android:textColorHint="@color/text_tertiary" />
    <Button android:id="@+id/btnPaste" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/paste_clipboard" android:layout_marginTop="@dimen/pad_sm"
        android:background="@drawable/outline_box" android:textColor="@color/brand" android:minHeight="@dimen/touch" />
    <CheckBox android:id="@+id/cbNumbered" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="নম্বর অনুযায়ী বসান (Lecture 5)" android:checked="true"
        android:layout_marginTop="@dimen/pad_sm" android:textColor="@color/text_primary" android:minHeight="@dimen/touch" />
    <CheckBox android:id="@+id/cbOverwrite" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="আগের লিঙ্ক মুছে নতুন বসান" android:checked="true"
        android:textColor="@color/text_primary" android:minHeight="@dimen/touch" />
    <CheckBox android:id="@+id/cbExpand" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="প্রয়োজনে লেকচার সংখ্যা বাড়ান" android:checked="true"
        android:textColor="@color/text_primary" android:minHeight="@dimen/touch" />
    <TextView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pad_md" android:textSize="12sp" android:textColor="@color/text_secondary" />
</LinearLayout>
</ScrollView>
