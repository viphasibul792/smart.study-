<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below auto-backup: include the Room DB and preferences. -->
<full-backup-content>
    <include domain="database" path="session_tracks.db" />
    <include domain="database" path="session_tracks.db-wal" />
    <include domain="database" path="session_tracks.db-shm" />
    <include domain="sharedpref" path="session_tracks_prefs.xml" />
    <exclude domain="file" path="exports/" />
</full-backup-content>
