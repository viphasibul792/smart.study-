<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup / device-transfer rules. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="session_tracks.db" />
        <include domain="sharedpref" path="session_tracks_prefs.xml" />
        <exclude domain="file" path="exports/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="session_tracks.db" />
        <include domain="sharedpref" path="session_tracks_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
