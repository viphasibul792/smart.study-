<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.SessionTracks" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colour roles -->
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorTertiary">@color/md_secondary</item>
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/md_background</item>
        <item name="android:navigationBarColor">@color/md_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Shapes -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.SessionTracks.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.SessionTracks.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.SessionTracks.Large</item>

        <!-- Typography -->
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.SessionTracks.Headline</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.SessionTracks.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.SessionTracks.Title</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.SessionTracks.Body</item>

        <!-- Component defaults -->
        <item name="materialCardViewStyle">@style/Widget.SessionTracks.Card</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.SessionTracks.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.SessionTracks.BottomSheet</item>
        <item name="linearProgressIndicatorStyle">@style/Widget.SessionTracks.Progress</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="Theme.SessionTracks" parent="Base.Theme.SessionTracks" />

    <!-- ===== Shapes ===== -->
    <style name="ShapeAppearance.SessionTracks.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_sm</item>
    </style>

    <style name="ShapeAppearance.SessionTracks.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_md</item>
    </style>

    <style name="ShapeAppearance.SessionTracks.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_lg</item>
    </style>

    <!-- ===== Dialog / bottom sheet overlays ===== -->
    <style name="ThemeOverlay.SessionTracks.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.SessionTracks.Large</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.SessionTracks.Title</item>
    </style>

    <style name="MaterialAlertDialog.SessionTracks.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textSize">@dimen/text_title_lg</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="ThemeOverlay.SessionTracks.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.SessionTracks.BottomSheet</item>
        <item name="android:navigationBarColor">@color/md_surface</item>
    </style>

    <style name="Widget.SessionTracks.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.SessionTracks.BottomSheet</item>
        <item name="backgroundTint">@color/md_surface</item>
    </style>

    <style name="ShapeAppearance.SessionTracks.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_xl</item>
        <item name="cornerSizeTopRight">@dimen/radius_xl</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Splash-free launch theme keeps cold start fast and branded. -->
    <style name="Theme.SessionTracks.Launcher" parent="Theme.SessionTracks">
        <item name="android:windowBackground">@color/screen_background</item>
    </style>

</resources>
