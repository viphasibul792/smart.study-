<?xml version="1.0" encoding="utf-8"?>
<!-- Backup & restore bottom sheet (.json export / import). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xl"
    android:paddingEnd="@dimen/space_xl"
    android:paddingBottom="@dimen/space_2xl">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginBottom="@dimen/space_md"
        android:background="@drawable/bg_bottom_sheet_handle"
        android:importantForAccessibility="no" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/backup_title"
        android:textAppearance="@style/TextAppearance.SessionTracks.TitleLarge" />

    <TextView
        android:id="@+id/lastBackupText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xxs"
        android:textAppearance="@style/TextAppearance.SessionTracks.Caption"
        tools:text="সর্বশেষ ব্যাকআপ: 14 Aug 2026, 7:30 PM" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/backupProgressBar"
        style="@style/Widget.SessionTracks.Progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:indeterminate="true"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Export -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/exportCard"
        style="@style/Widget.SessionTracks.Card.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_target_min"
            android:orientation="horizontal"
            android:padding="@dimen/space_lg">

            <ImageView
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_download"
                app:tint="@color/md_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_lg"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/backup_export"
                    android:textAppearance="@style/TextAppearance.SessionTracks.BodyLarge"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/backup_export_desc"
                    android:textAppearance="@style/TextAppearance.SessionTracks.Caption" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Import -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/importCard"
        style="@style/Widget.SessionTracks.Card.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_target_min"
            android:orientation="horizontal"
            android:padding="@dimen/space_lg">

            <ImageView
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_folder_open"
                app:tint="@color/md_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_lg"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/backup_import"
                    android:textAppearance="@style/TextAppearance.SessionTracks.BodyLarge"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/backup_import_desc"
                    android:textAppearance="@style/TextAppearance.SessionTracks.Caption" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Share -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/shareBackupButton"
        style="@style/Widget.SessionTracks.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/backup_share"
        app:icon="@drawable/ic_share" />

</LinearLayout>
