<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    tools:context=".ui.chapter.ChapterDetailActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/screen_background"
        app:elevation="0dp"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.SessionTracks.Toolbar"
            app:menu="@menu/menu_chapter_detail"
            app:navigationContentDescription="@string/action_back"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:subtitleTextAppearance="@style/TextAppearance.SessionTracks.Caption"
            tools:subtitle="Physics"
            tools:title="অধ্যায় ০২: ভেক্টর" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/list_bottom_padding"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding_horizontal"
            android:paddingEnd="@dimen/screen_padding_horizontal">

            <!-- Progress card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SessionTracks.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:layout_marginBottom="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/progressPercentText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.SessionTracks.Headline"
                                tools:text="60% সম্পন্ন" />

                            <TextView
                                android:id="@+id/progressDetailText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.SessionTracks.Body"
                                tools:text="২০ টির মধ্যে ১২ টি সম্পন্ন" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/notesButton"
                            style="@style/Widget.SessionTracks.Button.Tonal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/notes_chapter_title"
                            android:text="@string/notes_title"
                            app:icon="@drawable/ic_note" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/chapterProgressBar"
                        style="@style/Widget.SessionTracks.Progress.Large"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        tools:progress="60" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Lecture count + bulk import controls -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SessionTracks.Card.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/totalLecturesInputLayout"
                        style="@style/Widget.SessionTracks.TextInputLayout"
                        android:hint="@string/chapter_total_lectures"
                        app:endIconMode="custom"
                        app:endIconContentDescription="@string/action_apply"
                        app:endIconDrawable="@drawable/ic_check"
                        app:startIconDrawable="@drawable/ic_list_numbered">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/totalLecturesEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/chapter_total_lectures_hint"
                            android:imeOptions="actionDone"
                            android:inputType="number"
                            android:maxLength="4"
                            android:maxLines="1"
                            tools:ignore="Autofill" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bulkImportButton"
                        style="@style/Widget.SessionTracks.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/bulk_title"
                        app:icon="@drawable/ic_content_paste"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <include
                android:id="@+id/emptyState"
                layout="@layout/partial_empty_state" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lecturesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="@dimen/space_md"
                android:visibility="gone"
                tools:itemCount="12"
                tools:listitem="@layout/item_lecture"
                tools:spanCount="3"
                tools:visibility="visible" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
