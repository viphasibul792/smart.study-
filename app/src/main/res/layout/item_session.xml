<?xml version="1.0" encoding="utf-8"?>
<!-- One expandable study session card containing its subject list. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sessionCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md"
    style="@style/Widget.SessionTracks.Card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header row: colour bar, title, time, expand toggle, overflow -->
        <LinearLayout
            android:id="@+id/sessionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:baselineAligned="false"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_target_min"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_lg"
            android:paddingTop="@dimen/space_lg"
            android:paddingEnd="@dimen/space_sm"
            android:paddingBottom="@dimen/space_lg">

            <View
                android:id="@+id/sessionColorBar"
                android:layout_width="@dimen/session_color_bar_width"
                android:layout_height="44dp"
                android:background="@drawable/bg_session_color_bar"
                android:contentDescription="@string/cd_session_color"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/sessionNameText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.SessionTracks.Title"
                        tools:text="সেশন ১" />

                    <TextView
                        android:id="@+id/liveBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:background="@drawable/bg_progress_badge"
                        android:paddingStart="@dimen/space_sm"
                        android:paddingTop="2dp"
                        android:paddingEnd="@dimen/space_sm"
                        android:paddingBottom="2dp"
                        android:text="@string/dashboard_session_live"
                        android:textColor="@color/on_success_container"
                        android:textSize="@dimen/text_overline"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>

                <TextView
                    android:id="@+id/sessionTimeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:drawablePadding="@dimen/space_xs"
                    android:textAppearance="@style/TextAppearance.SessionTracks.Body"
                    app:drawableStartCompat="@drawable/ic_time"
                    app:drawableTint="@color/text_tertiary"
                    tools:text="7:00 PM – 8:00 PM" />

                <TextView
                    android:id="@+id/sessionSubjectCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.SessionTracks.Caption"
                    tools:text="২ টি বিষয় • 60%" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/expandButton"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_collapse"
                android:src="@drawable/ic_expand_more"
                app:tint="@color/text_secondary" />

            <ImageButton
                android:id="@+id/sessionMenuButton"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_more_options"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/sessionProgressBar"
            style="@style/Widget.SessionTracks.Progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_lg"
            android:layout_marginEnd="@dimen/space_lg"
            tools:progress="60" />

        <!-- Expandable body -->
        <LinearLayout
            android:id="@+id/sessionBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_lg"
            android:paddingTop="@dimen/space_md"
            android:paddingEnd="@dimen/space_lg"
            android:paddingBottom="@dimen/space_md">

            <TextView
                android:id="@+id/emptySubjectsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dashed_outline"
                android:gravity="center"
                android:padding="@dimen/space_lg"
                android:text="@string/session_empty_subjects"
                android:textAppearance="@style/TextAppearance.SessionTracks.Body"
                android:visibility="gone"
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/subjectsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="2"
                tools:listitem="@layout/item_subject" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addSubjectButton"
                style="@style/Widget.SessionTracks.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/session_add_subject"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
